{
	"compilerOptions": {
		"target": "es2024",
		"module": "preserve",
		"moduleResolution": "bundler",
		"lib": ["es2024", "dom", "dom.iterable", "webworker"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"types": ["vitest/importMeta"]
	},
	"include": ["index.d.ts", "test/**/*.ts", "vitest*.ts"]
}
