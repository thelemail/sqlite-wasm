{
  "name": "@thelemail/sqlite-wasm",
  "version": "3.54.0-mc2.6.1",
  "description": "SQLite compiled to WebAssembly with SQLite3 Multiple Ciphers and FTS5",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thelemail/sqlite-wasm.git"
  },
  "files": [
    "dist/sqlite3.mjs",
    "dist/sqlite3.wasm",
    "dist/manifest.json",
    "index.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/sqlite3.mjs"
    },
    "./sqlite3.wasm": "./dist/sqlite3.wasm",
    "./manifest.json": "./dist/manifest.json"
  },
  "sideEffects": false,
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "scripts/build.sh",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "test:safari": "vitest run --config vitest.safari.config.ts"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/browser-webdriverio": "5.0.0",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "webdriverio": "10.2.0"
  }
}
